{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustPlay",
  "version": "0.2.1",
  "identifier": "app.rustplay.receiver",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustPlay",
        "width": 980,
        "height": 680,
        "minWidth": 520,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#1c1c1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOWNLOAD/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
